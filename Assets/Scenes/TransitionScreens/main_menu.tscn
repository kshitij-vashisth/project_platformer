theme_override_fonts/font = ExtResource("4_6qsvb")
theme_override_font_sizes/font_size = 32
text = "THIS GAME TELLS THE STORY OF DAVE — AN ORDINARY BOY LIVING IN A WORLD WHERE LOGIC IS OPTIONAL. DAVE HAS ONE OBSESSION: KERMITT. TO HIM, KERMITT IS A HERO, A LEGEND, AND THE GREATEST BEING EVER CREATED. HIS FRIENDS HATE KERMITT AND THINK DAVE'S OBSESSION IS GETTING UNHEALTHY. DAVE ONCE EVEN SUGGESTED “TRR, TRR” AS A PICKUP LINE. HIS FRIENDS STILL HAVEN'T RECOVERED.

BUT DAVE DOESN'T CARE. KERMITT IS THE GREATEST. AND TONIGHT, DAVE IS ABOUT TO DISCOVER THAT IN HIS WORLD, A FICTIONAL FROG MIGHT BE THE LEAST WEIRD THING AROUND.

PLEASE DON'T BE LIKE DAVE."
autowrap_mode = 3

